# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these are repository secrets instead, and there is no
# .env file at all.

# Adzuna search API - free tier at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Gemini - https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Optional. Comma-separated list of origins the API will accept browser
# requests from. Only needed in production, where the frontend is on another
# domain. Defaults to the local Vite ports.
# CORS_ORIGINS=https://your-name.github.io
