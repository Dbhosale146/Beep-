# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these are repository secrets instead, and there is no
# .env file at all.

# Adzuna search API - free tier at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Gemini - https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Optional. Comma-separated list of origins the API will accept browser
# requests from. Only needed in production, where the frontend is on another
# domain. Defaults to the local Vite ports.
# CORS_ORIGINS=https://your-name.github.io

# ---- Google Sign-In (api/auth.py) ----

# The SAME client id as the frontend's VITE_GOOGLE_CLIENT_ID. The API checks
# that a token's `aud` claim equals this, which is what stops a token minted
# for some other Google app being accepted here.
GOOGLE_CLIENT_ID=

# Refuse anonymous callers on /api/jobs, /api/jobs/{id} and /api/meta.
# Off by default so local development and the tests need no tokens.
# /api/health and /api/auth/config stay open either way.
# REQUIRE_AUTH=true

# Optional. Without it, anyone with a Google account can sign in, which is
# usually right for a public job board. Set it to lock access to named people.
# ALLOWED_EMAILS=you@gmail.com,someone@else.com
