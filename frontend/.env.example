# Where the built frontend should look for the API.
#
# Leave this unset for local development: vite.config.js proxies /api to
# http://127.0.0.1:8000, so there is nothing to configure.
#
# Set it only for a production build, to the deployed API's base URL,
# including the /api path:
#   VITE_API_BASE=https://beep-jobs-api.onrender.com/api
VITE_API_BASE=
